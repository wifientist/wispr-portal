# WISPr Portal - Environment Configuration
# Copy this file to .env and fill in your values

# Server port (default: 8080)
PORT=8080

# RUCKUS One integration key (shared secret)
# If set, the server uses this key instead of requiring it from the client
# INTEGRATION_KEY=your-integration-key-here

# Default NBI IP / tenant URL (optional)
# NBI_IP=yourtenant.wispr.ruckus.cloud

# Flask debug mode (set to true for local development)
FLASK_DEBUG=false

# SSL verification for outbound RUCKUS API calls (default: false)
# Set to true in production with proper certificates
SSL_VERIFY=false

# Rate limit for /api/authenticate endpoint (default: 30 per minute)
# Uses flask-limiter syntax: "X per minute", "X per hour", etc.
RATE_LIMIT=30 per minute

# CORS allowed origins (default: * allows all)
# For production, set to your specific domain(s)
# CORS_ORIGINS=https://yourdomain.com
